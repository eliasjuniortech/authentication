generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  password  String
  imagePath String?  @map("image_path")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@map("users")
}
